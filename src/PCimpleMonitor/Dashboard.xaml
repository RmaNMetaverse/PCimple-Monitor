<Window x:Class="PCimple.Dashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PCimple"
        Title="PCimple Monitor" Width="680" Height="660" MinWidth="390" MinHeight="370"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Canvas}" Foreground="{DynamicResource Primary}">
  <Grid Margin="22,18,22,14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Border CornerRadius="17" Padding="18,17" Background="{DynamicResource Hero}">
      <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="11" Background="{DynamicResource HeroBadge}" Margin="0,0,13,0">
          <Path Data="M 2,12 L 7,12 L 10,5 L 14,19 L 18,9 L 22,12 L 27,12"
                Stroke="{DynamicResource HeroText}" StrokeThickness="2.3" StrokeStartLineCap="Round"
                StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="PCimple Monitor" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource HeroText}"/>
          <TextBlock Text="Temperature and hardware health" FontSize="12" TextWrapping="Wrap"
                     Foreground="{DynamicResource HeroText}" Margin="0,2,0,0"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <ScrollViewer Grid.Row="1" Margin="0,11,0,9" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <local:SensorTable Margin="0,0,3,0"/>
    </ScrollViewer>
    <DockPanel Grid.Row="2" LastChildFill="True">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="{Binding WidgetLabel}" Click="ToggleWidget" Padding="10,5" Margin="0,0,6,0"/>
        <Button Content="Reset statistics" Click="Reset" Padding="10,5"/>
      </StackPanel>
      <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Secondary}" FontSize="11"
                 VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,9,0"/>
    </DockPanel>
  </Grid>
</Window>
