<Window x:Class="PCimple.Widget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PCimple"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="PCimple Monitor widget" Width="350" Height="410" MinWidth="290" MinHeight="230"
        ShowInTaskbar="False" WindowStyle="None" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource Canvas}" Foreground="{DynamicResource Primary}">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="12"/>
  </shell:WindowChrome.WindowChrome>
  <Border Padding="12" BorderBrush="{DynamicResource Outline}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel Background="Transparent" MouseLeftButtonDown="Drag" Margin="0,0,0,4" LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <CheckBox x:Name="Pin" Content="Pin" Click="PinChanged" ToolTip="Keep the widget above other windows"
                    VerticalAlignment="Center" Margin="0,0,5,0"/>
          <Button Content="×" Click="HideWidget" FontSize="18" Padding="6,0"
                  AutomationProperties.Name="Hide widget"/>
        </StackPanel>
        <TextBlock Text="PCimple Monitor" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14"/>
      </DockPanel>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <local:SensorTable Margin="0,0,2,0"/>
      </ScrollViewer>
    </Grid>
  </Border>
</Window>
